{
  "name": "arqlearn",
  "private": true,
  "description": "ArqLearn — monorepo dos apps cliente (web + mobile). Backend Go vive em /services, fora deste workspace.",
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "web": "npm run dev --workspace=apps/web",
    "mobile": "npm run start --workspace=apps/mobile",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report e2e/visual/report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
