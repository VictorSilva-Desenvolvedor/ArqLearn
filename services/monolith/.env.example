# Copiar para .env e preencher com valores reais — nunca commitar o .env preenchido.

SUPABASE_URL=
SUPABASE_DATA_API_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY_LEGACY=

DATABASE_URL=

MONGODB_URI=
MONGODB_DATABASE=arqlearn

# IA — ver Docs/ArqLearn_Estrategia_Bootstrap.md §4. Gemini = geração de pergunta (multimodal),
# Groq = chat/"explique melhor" (latência baixa). DeepSeek e OpenAI descartados — exigem cartão
# pra uso real, ver Docs/PENDENCIAS_IA.md.
GEMINI_API_KEY=
GROQ_API_KEY=

# Cloudflare R2 (object storage) — ver Docs/ArqLearn_Estrategia_Bootstrap.md §3.
R2_ACCOUNT_ID=
R2_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
R2_BUCKET_NAME=
