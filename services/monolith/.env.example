# Copiar para .env e preencher com valores reais — nunca commitar o .env preenchido.

SUPABASE_URL=
SUPABASE_DATA_API_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY_LEGACY=

DATABASE_URL=

MONGODB_URI=
MONGODB_DATABASE=arqlearn

# IA — ver Docs/ArqLearn_Estrategia_Bootstrap.md §4. Gemini = geração de pergunta (multimodal),
# Groq = chat/"explique melhor" (latência baixa). DeepSeek descartado — exige cartão pra uso real.
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENAI_API_KEY: exige cartão cadastrado pra emitir a chave — fora do critério "sem cartão"
# desta fase, ver Docs/CLAUDE.md. Só preencher se for uma decisão consciente de usar mesmo assim.
OPENAI_API_KEY=
