# Mesmo projeto Supabase usado por apps/web e services/monolith — ver apps/web/.env.example.
# Expo usa o prefixo EXPO_PUBLIC_ (não NEXT_PUBLIC_) para expor env vars ao bundle do client.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend real (services/monolith). Em desenvolvimento local no emulador Android, "localhost"
# aponta pro próprio emulador, não pra máquina host — use 10.0.2.2 (Android) ou o IP da máquina
# na rede local (dispositivo físico/Expo Go). Em produção, aponta pro Render.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Ver o comentário equivalente em apps/web/.env.example para a lista de nomes de recurso
# reconhecidos por src/lib/api/config.ts#isResourceReal.
EXPO_PUBLIC_API_REAL_RESOURCES=
